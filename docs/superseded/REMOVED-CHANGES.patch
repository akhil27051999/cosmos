er", "layer": "Resilience layer", "color": "#F0623C", "logo": "redis", "glyph": "\ud83d\udd04", "what": "Smart retries that wait longer each time, with randomness (jitter).", "role": "Recovers from brief, transient errors without all workers retrying in sync.", "why": "Networks blip; naive retries cause a stampede \u2014 jitter spreads them out.", "pros": ["Higher success rate", "Avoids thundering herd"], "cons": ["Can amplify load if misconfigured"]}, "fallback": {"name": "Fallback chain", "layer": "Resilience layer", "color": "#F0623C", "logo": "redis", "glyph": "\ud83e\ude82", "what": "An ordered list of backup providers.", "role": "If the primary fails, quietly try the next one so the user still gets an answer.", "why": "Keeps the service useful during a partial outage.", "pros": ["Graceful degradation"], "cons": ["Can hide root causes \u2014 use carefully"]}, "shed": {"name": "Load shedding", "layer": "Resilience layer", "color": "#F0623C", "logo": "redis", "glyph": "\ud83d\udeb0", "what": "Deliberately dropping excess requests under overload.", "role": "Protects the system so it stays up for most users instead of collapsing for all.", "why": "Partial service beats total meltdown when demand exceeds capacity.", "pros": ["System stays alive under spikes"], "cons": ["Some requests are rejected"]}, "kafka": {"name": "Kafka / Redpanda", "layer": "Event backbone", "color": "#5FD08A", "logo": "kafka", "glyph": null, "what": "A distributed, durable event log (Redpanda is a drop-in Kafka).", "role": "The queue that decouples the fast gateway from the slower workers; jobs wait here safely.", "why": "Durable, ordered, replayable and high-throughput \u2014 the backbone of event-driven systems.", "pros": ["Durable & replayable", "Scales to huge throughput", "Decouples producers/consumers"], "cons": ["Operationally complex"]}, "schema": {"name": "Schema Registry", "layer": "Event backbone", "color": "#5FD08A", "logo": "kafka", "glyph": "\ud83d\udcd0", "what": "A registry of