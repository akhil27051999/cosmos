+    if(chk && (e.key===" "||e.key==="Enter")){ e.preventDefault(); var card=chk.closest(".stage"); setDone(card, card.dataset.stage, !state[card.dataset.stage]); }
+  });
+
+  // restore done state
+  document.querySelectorAll(".stage").forEach(function(card){
