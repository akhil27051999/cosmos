", "color": "#B57BD6", "logo": "githubactions", "glyph": null, "what": "The CI system that builds, tests and ships.", "role": "Runs on every push and deploys to the cloud using short-lived OIDC tokens (no stored keys).", "why": "Keyless cloud auth removes the biggest secret-leak risk in CI.", "pros": ["Keyless, safer deploys", "Tight GitHub integration"], "cons": ["YAML sprawl at scale"]}, "argocd": {"name": "Argo CD \u00b7 GitOps", "layer": "Delivery & supply chain", "color": "#B57BD6", "logo": "argocd", "glyph": null, "what": "A GitOps continuous-delivery tool.", "role": "Keeps the cluster exactly matching what's declared in Git, automatically.", "why": "Git becomes the single source of truth; drift self-corrects.", "pros": ["Declarative & auditable", "Auto drift-correction"], "cons": ["Everything must live in Git"]}, "rollouts": {"name": "Argo Rollouts", "layer": "Delivery & supply chain", "color": "#B57BD6", "logo": "argocd", "glyph": null, "what": "Progressive-delivery controller.", "role": "Releases new versions gradually (canary / blue-green) and auto-rolls-back on bad metrics.", "why": "De-risks every deploy by testing on a slice of real traffic first.", "pros": ["Safe, gradual releases", "Metric-based auto-rollback"], "cons": ["Adds release-config complexity"]}, "terraform": {"name": "Terraform / Crossplane", "layer": "Delivery & supply chain", "color": "#B57BD6", "logo": "terraform", "glyph": null, "what": "Infrastructure-as-Code tools.", "role": "Define all cloud infrastructure (network, clusters, databases) as versioned code.", "why": "Reproducible, reviewable infrastructure instead of manual clicking.", "pros": ["Reproducible infra", "Peer-reviewable changes"], "cons": ["State management care needed"]}, "supply": {"name": "SBOM \u00b7 cosign \u00b7 SLSA", "layer": "Delivery & supply chain", "color": "#B57BD6", "logo": "github", "glyph": "\ud83d\udd0f", "what": "Software supply-chain security tooling.", "role": "Lists everything in each image, signs it, and proves how it was built.", "why": "Lets us verify nothing was tampered with before it runs in production.", "pros": ["Tamper-evident builds", "Provenance & trust"], "cons": ["Extra CI steps to maintain"]}, "otel": {"name": "OpenTelemetry", "layer": "Observability & SRE", "color": "#E0678F", "logo": "opentelemetry", "glyph": null, "what": "A vendor-neutral standard for traces, metrics and logs.", "role": "Tags each request so we can follow it across every service (async, Kafka, gRPC).", "why": "One standard instrumentation instead of per-vendor agents.", "pros": ["Vendor-neutral", "End-to-end request traces"], "cons": ["Instrumentation effort"]}, "prom": {"name": "Prometheus", "layer": "Observability & SRE", "color": "#E0678F", "logo": "prometheus", "glyph": null, "what": "A metrics database and alerting engine.", "role": "Collects numbers (latency, error rate, queue depth) and fires alerts on rules.", "why": "The de-facto standard for cloud-native metrics.", "pros": ["Powerful queries", "Strong alerting"], "cons": ["Long-term storage needs add-ons"]}, "loki": {"name": "Loki", "layer": "Observability & SRE", "color": "#E0678F", "logo": "grafana", "glyph": null, "what": "A log aggregation system.", "role": "Centralizes logs from every service so we can search them in one place.", "why": "Cheap, label-based logs that pair naturally with Grafana.", "pros": ["Cheap log storage", "Grafana-native"], "cons": ["Not full-text like Elasticsearch"]}, "grafana": {"name": "Grafana", "layer": "Observability & SRE", "color": "#E0678F", "logo": "grafana", "glyph": null, "what": "The visualization layer.", "role": "Dashboards that show the health of the entire system at a glance.", "why": "Single pane of glass over metrics, logs and traces.", "pros": ["One place for everything", "Beautiful dashboards"], "cons": ["Dashboard maintenance"]}, "pyro": {"name": "Pyroscope", "layer": "Observability & SRE", "color": "#E0678F", "logo": "grafana", "glyph": "\ud83d\udd25", "what": "Continuous profiling.", "role": "Shows exactly which code lines burn CPU/memory in production.", "why": "Finds performance hot-spots that metrics alone can't.", "pros": ["Pinpoints hot code paths"], "cons": ["Small runtime overhead"]}, "slo": {"name": "SLOs + burn-rate alerts", "layer": "Observability & SRE", "color": "#E0678F", "logo": "prometheus", "glyph": "\ud83c\udfaf", "what": "Service Level Objectives with error budgets.", "role": "Define 'good enough' reliability and alert only when we're burning the budget too fast.", "why": "Alerts on user-impact, not noise \u2014 the heart of SRE.", "pros": ["Meaningful, low-noise alerts", "Aligns eng with users"], "cons": ["Requires honest target-setting"]}, "chaos": {"name": "Chaos Mesh", "layer": "Observability & SRE", "color": "#E0678F", "logo": "kubernetes", "glyph": "\ud83c\udf2a\ufe0f", "what": "A chaos-engineering tool.", "role": "Deliberately injects failures (kill pods, add latency) to prove resilience.", "why": "You only know it's resilient if you've tested failure on purpose.", "pros": ["Proves resilience", "Finds weak spots early"], "cons": ["Must be run carefully"]}, "k6": {"name": "k6", "layer": "Observability & SRE", "color": "#E0678F", "logo": "k6", "glyph": null, "what": "A load-testing tool.", "role": "Simulates heavy traffic to find limits before real users do.", "why": "Scriptable, developer-friendly performance testing.", "pros": ["Realistic load tests", "Scriptable in JS"], "cons": ["Test design takes effort"]}};
