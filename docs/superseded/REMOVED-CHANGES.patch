nnotated with what it is, its role, why chosen, and its trade-offs · logos identify each tool</div></div></div><div class="scrim" id="scrim"></div><aside class="drawer" id="drawer"></aside><div class="narr" id="narr"></div><script>window.LOGOS={"cloudflare": "data:image/svg+xml;base64,", "amazonwebservices": "data:image/svg+xml;base64,", "nginx": "data:image/svg+xml;base64,", "kubernetes": "data:image/svg+xml;base64,", "react": "data:image/svg+xml;base64,", "fastapi": "data:image/svg+xml;base64,", "keycloak": "data:image/svg+xml;base64,", "redis": "data:image/svg+xml;base64,", "kafka": "data:image/svg+xml;base64,", "go": "data:image/svg+xml;base64,", "anthropic": "data:image/svg+xml;base64,", "postgresql": "data:image/svg+xml;base64,", "grpc": "data:image/svg+xml;base64,", "istio": "data:image/svg+xml;base64,PHN2ZyBmaWxsPSI0NjZCQjAiIHJvbGU9ImltZyIgdmlld0JveD0iMCAwIDI0IDI0IiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjx0aXRsZT5Jc3RpbzwvdGl0bGU+PHBhdGggZD0iTTQgMjEgMjAgMjEgMTAgMjR6TTQgMjAgMTAgMTkgMTAgOHpNMTEgMTkgMjAgMjAgMTEgMHoiLz48L3N2Zz4=", "mongodb": "data:image/svg+xml;base64,", "qdrant": "data:image/svg+xml;base64,", "minio": "data:image/svg+xml;base64,", "clickhouse": "data:image/svg+xml;base64,", "helm": "data:image/svg+xml;base64,", "vault": "data:image/svg+xml;base64,", "githubactions": "data:image/svg+xml;base64,", "argocd": "data:image/svg+xml;base64,", "terraform": "data:image/svg+xml;base64,", "github": "data:image/svg+xml;base64,", "opentelemetry": "data:image/svg+xml;base64,", "prometheus": "data:image/svg+xml;base64,", "grafana": "data:image/svg+xml;base64,", "k6": "data:image/svg+xml;base64,"};</script><script>
+var DETAIL = {"cloudflare": {"name": "Cloudflare CDN", "layer": "Client & Edge", "color": "#5CC8E0", "logo": "cloudflare", "glyph": null, "what": "A global content-delivery & edge network with 300+ locations worldwide.", "role": "Serves cached content close to users and absorbs traffic before it hits our servers.", "why": "Massive free tier, built-in DDoS protection and WAF, and very low latency.", "pros": ["Global edge = fast for everyone", "Built-in DDoS + bot protection", "Cheap / generous free tier"], "cons": ["One more vendor to manage", "Cache invalidation needs care"]}, "waf": {"name": "AWS WAF", "layer": "Client & Edge", "color": "#5CC8E0", "logo": "amazonwebservices", "glyph": null, "what": "A Web Application Firewall that inspects incoming HTTP requests.", "role": "Blocks malicious requests (SQL injection, bad bots) before they reach the app.", "why": "Fully managed, ships with common attack rule-sets, integrates with our AWS load balancer.", "pros": ["Managed OWASP rule-sets", "Blocks attacks at the edge"], "cons": ["Per-rule cost", "Needs tuning to avoid false blocks"]}, "ingress": {"name": "Ingress controller", "layer": "Client & Edge", "color": "#5CC8E0", "logo": "nginx", "glyph": null, "what": "A reverse proxy that is the single front door into the Kubernetes cluster.", "role": "Routes each incoming request to the correct internal service by host/path, terminating TLS.", "why": "Nginx ingress is mature, battle-tested and flexible.", "pros": ["Mature & flexible routing", "Central place for TLS & rules"], "cons": ["A choke point to scale & secure carefully"]}, "dns": {"name": "Route 53 \u00b7 DNS", "layer": "Client & Edge", "color": "#5CC8E0", "logo": "amazonwebservices", "glyph": null, "what": "Amazon's managed DNS service.", "role": "Turns our domain name into the IP address of the load balancer, with health-based failover.", "why": "AWS-native, supports latency/geo routing and health checks for multi-region.", "pros": ["Health-checked failover", "Latency & geo routing"], "cons": ["Ties DNS to AWS"]}, "tls": {"name": "cert-manager / ACM", "layer": "Client & Edge", "color": "#5CC8E0", "logo": "kubernetes", "glyph": "\ud83d\udd12", "what": "Automated TLS-certificate issuance and renewal.", "role": "Gives every endpoint HTTPS and auto-renews certs so they never expire.", "why": "Automates free ACME/Let's Encrypt certs inside the cluster \u2014 no manual renewals.", "pros": ["Auto-renew = no expiry outages", "Free certificates"], "cons": ["Depends on the cluster & DNS setup"]}, "frontend": {"name": "Next.js \u00b7 React \u00b7 TypeScript", "layer": "Presentation", "color": "#A99BFF", "logo": "react", "glyph": null, "what": "The web dashboard, built with React + Next.js and typed with TypeScript.", "role": "Where users submit jobs, watch progress live, and view queue / health / usage.", "why": "Server-side rendering, great developer experience, and types that catch bugs early.", "pros": ["Fast, SEO-friendly rendering", "Types prevent whole classes of bugs", "Huge ecosystem"], "cons": ["Build tooling is complex", "Frontend churn"]}, "sse": {"name": "SSE live stream", "layer": "Presentation", "color": "#A99BFF", "logo": "react", "glyph": "\ud83d\udce1", "what": "Server-Sent Events \u2014 a one-way live stream over plain HTTP.", "role": "Pushes the agent's thinking to the browser token-by-token as it happens.", "why": "Simpler than WebSockets when you only need server\u2192browser streaming.", "pros": ["Simple, HTTP-native, auto-reconnect"], "cons": ["One-way only", "Browser connection limits"]}, "fastapi": {"name": "FastAPI gateway", "layer": "API Gateway", "color": "#F2B24A", "logo": "fastapi", "glyph": null, "what": "An async Python web framework serving as the platform's front door.", "role": "Accepts a job and instantly returns 202 + a job id, so the user never waits.", "why": "Async-native (handles many requests at once), typed via Pydantic, auto-generates API docs.", "pros": ["Very fast & async", "Typed request validation", "Auto OpenAPI docs"], "cons": ["Requires async discipline", "Younger than Django/Flask"]}, "idem": {"name": "Idempotency + OCC", "layer": "API Gateway", "color": "#F2B24A", "logo": "fastapi", "glyph": "\ud83d\udd01", "what": "Idempotency keys plus optimistic concurrency control.", "role": "Makes retries safe (no double-processing) and prevents two writers from clobbering data.", "why": "Clients and networks retry automatically \u2014 the system must never act twice on one request.", "pros": ["Safe retries", "No lost updates"], "cons": ["Extra key storage & careful design"]}, "keycloak": {"name": "Keycloak \u00b7 OAuth2/OIDC/JWT", "layer": "API Gateway", "color": "#F2B24A", "logo": "keycloak", "glyph": null, "what": "An open-source identity provider speaking OAuth2 / OIDC / JWT.", "role": "Authenticates every caller and issues tokens that say what they're allowed to do.", "why": "Full-featured, standards-based, self-hosted \u2014 no per-user SaaS fees.", "pros": ["Industry-standard auth", "No per-user cost", "Self-hosted control"], "cons": ["Heavier to operate yourself"]}, "quota": {"name": "Quotas + usage ledger", "layer": "API Gateway", "color": "#F2B24A", "logo": "fastapi", "glyph": "\ud83d\udcca", "what": "Per-tenant rate/usage limits plus an append-only usage record.", "role": "Stops one customer starving the others and records usage for billing.", "why": "Multi-tenant fairness and accurate billing both need it.", "pros": ["Fair sharing", "Billing-grade usage data"], "cons": ["Accounting adds complexity"]}, "registry": {"name": "Provider registry & selector", "layer": "Control plane", "color": "#E8C15A", "logo": "fastapi", "glyph": "\ud83e\udded", "what": "A live registry of available LLM providers plus a routing strategy.", "role": "Picks a healthy provider for each job (round-robin / weighted / least-loaded).", "why": "We need to route, weight and fail over between providers at runtime, not in code.", "pros": ["Flexible routing", "Easy failover"],