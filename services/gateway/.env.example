# Copy to `.env` for local runs (12-factor: config comes from the environment).
# The values below match the docker-compose Postgres.

APP_ENV=local
LOG_LEVEL=INFO

# asyncpg driver URL. Use host `localhost` when running the app on your machine,
# or host `postgres` when the app runs inside docker-compose.
DATABASE_URL=postgresql+asyncpg://cosmos:cosmos@localhost:5432/cosmos

# Set to true to log every SQL statement (useful while learning).
DB_ECHO=false
